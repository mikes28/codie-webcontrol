# Codie BLE konfiguráció — másold .env-be és töltsd ki.
# A .env gitignore-olt, nem kerül a repóba.

# A robot BLE címe (bluetoothctl scan le -> "Codie")
# Ez a cím a ROUTINGOS generációhoz tartozik (a codie/ Python kliens csak azt
# beszéli). A routing nélküli generációt a server/ web-backend kezeli.
CODIE_ADDRESS=DF:74:94:43:36:ED

# A használt Bluetooth adapter
CODIE_ADAPTER=hci0
