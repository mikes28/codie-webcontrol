# Codie BLE konfiguráció — másold .env-be és töltsd ki.
# A .env gitignore-olt, nem kerül a repóba.
# A repo gyökér .env-jét a backend (server/) is betölti — a közös értékek itt vannak.

# A robot BLE címe — ez a routing NÉLKÜLI generáció stabil címe
# (ki- és bekapcsolás után is ugyanaz). A routingos generációé (a random address)
# másik robot.
CODIE_ADDRESS=00:07:80:66:F0:DA

# A használt Bluetooth adapter
CODIE_ADAPTER=hci0
