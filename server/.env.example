# Codie web-backend konfiguráció — másold .env-be és töltsd ki.
# A repó gyökerének .env-je is betöltődik (a Python oldallal közös értékek).

# --- Szerver ---
PORT=3000
HOST=0.0.0.0

# --- BLE ---
# A használt Bluetooth adapter (a gép hci0 / hci1 ...).
CODIE_ADAPTER=hci0

# A robot hirdetett neve — a szűrő ezt használja (a Codie "Codie" néven hirdet).
# A BLE-címe nem változik (a 2026-10-20-i ki/bekapcsolás után is ugyanaz volt),
# így a név-szűrő mellett a MAC-allowlist is használható.
CODIE_ROBOT_NAME=Codie

# A hirdetett service UUID-k (a GATT szolgáltatás + a robot saját UUID-ja).
# A Codie két generációja létezik, mindkettőt szűrni tudjuk:
#   routingos         52af0001-978a-628d-c845-0a104ca2b8dd
#   routing nélküli   d46e7e53-ba2f-4044-ade9-f85ead45f458
CODIE_ROBOT_UUIDS=52af0001-978a-628d-c845-0a104ca2b8dd,d46e7e53ba2f4044ade9f85ead45f458

# Opcionális MAC-allowlist: csak ezek a címek fogadhatók el (vesszővel elválasztva).
# Üres = minden Codie átmegy.
# A routing nélküli generáció címe stabil (nem rotálódik), ezért a statikus
# allowlist is jól használható — a routingos generációénál viszont a
# CODIE_ROBOT_NAME-alapú szűrő a biztosabb.
CODIE_MAC_ALLOWLIST=

# Ha 1, akkor az allowlist önmagában is elég a felismeréshez (név/UUID nélkül).
CODIE_MAC_ONLY=0

# --- Időzítések (ms) ---
# Alapértelmezett scan-idő (a robot ritkán hirdet, ezért ne legyen rövid).
CODIE_SCAN_MS=10000
# Egy kapcsolódási kísérlet előtti ébresztő scan ablakja (a connect után,
# a retry-k között fut: ennyi ideig várunk a robot új hirdetésére).
CODIE_SCAN_WINDOW_MS=8000
# A BLE connect timeoutja.
CODIE_CONNECT_TIMEOUT_MS=20000
# Hány connect-próba (a robot közben elalvhat).
CODIE_CONNECT_RETRIES=3
# Várakozás a próbák között.
CODIE_RETRY_DELAY_MS=3000
# Telemetria (szenzorlekérés) periódusa; 0 = kikapcsolva.
# A felület érzékelőnként frissül (a mérés megérkezésekor), ezért ez a teljes
# állapotlekérés gyakoriságát adja meg: a robot egy lekérdezésre ~100 ms alatt
# válaszol, így a 4 érzékelős kör minimum ~400 ms.
CODIE_TELEMETRY_MS=250
# Általános válasz-timeout egy parancs nyugtázásához.
CODIE_RESPONSE_TIMEOUT_MS=2500
# Érzékelő-kérés timeoutja (a robot ~100 ms alatt válaszol).
CODIE_QUERY_TIMEOUT_MS=1200
# GATT-write timeoutja — enélkül elalvó robotnál lefagy a teljes szerver.
CODIE_WRITE_TIMEOUT_MS=3000
# A teljes állapotlekérés (4 érzékelő) legfeljebb ennyi ideig tarthat.
CODIE_STATUS_TIMEOUT_MS=10000
# Kötelező szünet két BLE-üzenet között (ms). A nyugtázatlan (ritmus) üzeneteknél
# mindenképp 150 ms kell, különben a firmware eldobja őket.
CODIE_WRITE_GAP_MS=50
# A mikrofon figyelésének periódusa (ms) — a felület szintmérője.
CODIE_MIC_MS=200

# --- Újracsatlakozás ---
# Ha a kapcsolat váratlanul megszakad (a robot elalvel), a backend újracsatlakozik.
# 0 = kikapcsolva (a felhasználó maga csatlakozik újra).
CODIE_AUTO_RECONNECT=1
# Hány alkalommal próbálja újra a kapcsolatot megszakadás után.
CODIE_RECONNECT_ATTEMPTS=3
# Késleltetés az újracsatlakozási próbálkozások között (ms).
CODIE_RECONNECT_DELAY_MS=5000

# A szerver indulásakor automatikusan csatlakozandó robotok (vesszővel elválasztva).
CODIE_AUTO_CONNECT=
