# Codie web-backend konfiguráció — másold .env-be és töltsd ki.
# A repó gyökerének .env-je is betöltődik (a Python oldallal közös értékek).

# --- Szerver ---
PORT=3000
HOST=0.0.0.0

# --- BLE ---
# A használt Bluetooth adapter (a gép hci0 / hci1 ...).
CODIE_ADAPTER=hci0

# A robot hirdetett neve — a szűrő ezt használja (a Codie "Codie" néven hirdet).
CODIE_ROBOT_NAME=Codie

# A hirdetett service UUID-k (a GATT szolgáltatás + a robot saját UUID-ja).
CODIE_ROBOT_UUIDS=52af0001-978a-628d-c845-0a104ca2b8dd,d46e7e53ba2f4044ade9f85ead45f458

# Opcionális MAC-allowlist: csak ezek a címek fogadhatók el (vesszővel elválasztva).
# Üres = minden Codie átmegy.
CODIE_MAC_ALLOWLIST=

# Ha 1, akkor az allowlist önmagában is elég a felismeréshez (név/UUID nélkül).
CODIE_MAC_ONLY=0

# --- Időzítések (ms) ---
# Alapértelmezett scan-idő (a robot ritkán hirdet, ezért ne legyen rövid).
CODIE_SCAN_MS=10000
# Egy kapcsolódási kísérlet előtti scanablak.
CODIE_SCAN_WINDOW_MS=8000
# A BLE connect timeoutja.
CODIE_CONNECT_TIMEOUT_MS=20000
# Hány connect-próba (a robot közben elalvhat).
CODIE_CONNECT_RETRIES=3
# Várakozás a próbák között.
CODIE_RETRY_DELAY_MS=3000
# Telemetria (szenzorlekérés) periódusa; 0 = kikapcsolva.
CODIE_TELEMETRY_MS=5000

# A szerver indulásakor automatikusan csatlakozandó robotok (vesszővel elválasztva).
CODIE_AUTO_CONNECT=
